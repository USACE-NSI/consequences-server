# Stage 1: Build - Use the production base image as the builder to ensure library parity
FROM ghcr.io/osgeo/gdal:alpine-small-3.8.3 AS builder

# Install build tools and manual Go 1.25.8
RUN apk add --no-cache \
    build-base \
    pkgconf \
    gdal-dev \
    git \
    wget \
    ca-certificates

# Manually install Go 1.25.8
ENV GO_VERSION=1.25.8
RUN wget https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go${GO_VERSION}.linux-amd64.tar.gz && \
    rm go${GO_VERSION}.linux-amd64.tar.gz

# Set Go paths
ENV GOROOT=/usr/local/go
ENV PATH=$GOROOT/bin:$PATH

WORKDIR /app

RUN git clone https://github.com/USACE-NSI/consequences-server .

# Build the binary with CGO enabled for GDAL
# Using -ldflags="-s -w" to strip the binary for even more space savings
RUN go mod download
RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -o /consequences-server server.go

# Stage 2: Production on Alpine-small GDAL base
FROM ghcr.io/osgeo/gdal:alpine-small-3.8.3 AS prod

ENV TZ=America/New_York

# Install runtime dependencies and timezone data
RUN apk add --no-cache tzdata gdal-dev \
    && cp /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone

# Copy the compiled binary
COPY --from=builder /consequences-server /usr/local/bin/consequences-server

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/consequences-server"]
